APP_NAME=Hospitality IT Operations Platform
APP_VERSION=3.0.0-dev
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg2://hiop:change-me@localhost:5432/hiop
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
SCHEDULER_ENABLED=true

# Legacy Email Configuration (Gmail - will be deprecated)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Production Email Configuration (NEW - use this instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=HIOP Notifications
SMTP_SENDER_ADDRESS=
SMTP_CONNECTION_TIMEOUT=15
SMTP_SEND_TIMEOUT=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF=5

# Multi-tenancy / Subdomain Routing
BASE_DOMAIN=localhost
ENABLE_SUBDOMAIN_ROUTING=false

SNMP_ENABLED=false
HIOP_SNMP_SECRET_KEY=
SNMP_ALLOW_LEGACY_PROTOCOLS=false
SNMP_ALLOW_V1=false
