APP_NAME=Hotel IT Operations Portal
APP_VERSION=2.0.0-dev
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+psycopg2://hiop:REPLACE_DATABASE_PASSWORD@db:5432/hiop
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
HIOP_AD_SECRET_KEY=REPLACE_WITH_A_DEDICATED_RANDOM_AD_ENCRYPTION_KEY
HIOP_DISCOVERY_CREDENTIAL_KEY=REPLACE_WITH_A_DEDICATED_RANDOM_DISCOVERY_ENCRYPTION_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://your-hiop-project.vercel.app"]
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
SCHEDULER_ENABLED=true
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=HIOP Notifications
SMTP_SENDER_ADDRESS=
SNMP_ENABLED=false
HIOP_SNMP_SECRET_KEY=REPLACE_WITH_A_DEDICATED_RANDOM_SNMP_ENCRYPTION_KEY
SNMP_ALLOW_LEGACY_PROTOCOLS=false
SNMP_ALLOW_V1=false
SNMP_V3_REQUIRED_IN_PRODUCTION=true
