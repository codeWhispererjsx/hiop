APP_NAME=HIOP Test
APP_VERSION=2.0.0-dev
ENVIRONMENT=testing
DEBUG=false
DATABASE_URL=postgresql+psycopg2://hiop_test:REPLACE_TEST_PASSWORD@localhost:5432/hiop_test
SECRET_KEY=replace-with-a-test-only-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:4173"]
LOG_LEVEL=WARNING
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=1800
SCHEDULER_ENABLED=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
SNMP_ENABLED=false
HIOP_SNMP_SECRET_KEY=test-only-snmp-encryption-key
SNMP_ALLOW_LEGACY_PROTOCOLS=false
SNMP_ALLOW_V1=false
